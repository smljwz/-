#!/usr/bin/env python3
"""从日志文件中提取报错行，并调用 DeepSeek 进行流式分析。"""

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

from openai import OpenAI
from openai import APIError, APIConnectionError, AuthenticationError, RateLimitError

def load_dotenv(path: Path) -> None:
    """读取同目录 .env，不覆盖已经存在的环境变量。"""
    if not path.is_file():
        return
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip()
        value = value.strip().strip('"').strip("'")
        os.environ.setdefault(key, value)


load_dotenv(Path(__file__).with_name(".env"))

# 也可直接改这里；不要把真实密钥提交到 GitHub。
API_KEY = os.getenv("DEEPSEEK_API_KEY", "").strip()
BASE_URL = os.getenv("DEEPSEEK_BASE_URL", "https://api.deepseek.com").strip()
MODEL = os.getenv("DEEPSEEK_MODEL", "deepseek-chat").strip()

KEYWORDS = ("ERROR", "Exception", "Traceback")
SYSTEM_PROMPT = (
    "你是一个资深的后端工程师。请用中文解释这段报错的原因，"
    "并给出具体的修复建议，如果是代码问题请给出修改后的代码。"
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="从日志文件中筛选报错行，并用 DeepSeek 流式分析。",
    )
    parser.add_argument(
        "log_path",
        nargs="?",
        type=Path,
        default=Path(__file__).with_name("sample.log"),
        help="日志文件路径（省略时默认使用同目录下的 sample.log）",
    )
    return parser.parse_args()


def extract_error_lines(log_path: Path) -> list[str]:
    """读取日志并返回命中关键词的行（去掉行尾换行）。"""
    matched: list[str] = []
    with log_path.open(encoding="utf-8", errors="replace") as file:
        for line_no, line in enumerate(file, start=1):
            stripped = line.rstrip("\n\r")
            if any(keyword in stripped for keyword in KEYWORDS):
                matched.append(f"{line_no}: {stripped}")
    return matched


def format_report(log_path: Path, matched_lines: list[str]) -> str:
    header = [
        "日志报错摘要",
        f"文件: {log_path}",
        f"关键词: {', '.join(KEYWORDS)}",
        f"命中行数: {len(matched_lines)}",
        "-" * 40,
    ]
    if not matched_lines:
        body = ["未找到包含关键词的行。"]
    else:
        body = matched_lines
    return "\n".join(header + body)


def analyze_errors_stream(error_text: str) -> None:
    """把报错文本发给 DeepSeek，并以流式方式打印分析结果。"""
    if not API_KEY.strip():
        raise ValueError("请先在 .env 中填写 DEEPSEEK_API_KEY，或设置同名环境变量。")
    if not BASE_URL.strip():
        raise ValueError("请先在 .env 中填写 DEEPSEEK_BASE_URL，或设置同名环境变量。")

    client = OpenAI(api_key=API_KEY, base_url=BASE_URL)
    stream = client.chat.completions.create(
        model=MODEL,
        messages=[
            {"role": "system", "content": SYSTEM_PROMPT},
            {"role": "user", "content": error_text},
        ],
        stream=True,
    )

    print("\nAI 分析结果：")
    print("-" * 40)
    for chunk in stream:
        if not chunk.choices:
            continue
        delta = chunk.choices[0].delta.content
        if delta:
            print(delta, end="", flush=True)
    print()


def main() -> int:
    args = parse_args()
    log_path: Path = args.log_path

    try:
        if not log_path.exists():
            raise FileNotFoundError(f"文件不存在: {log_path}")
        if not log_path.is_file():
            raise IsADirectoryError(f"路径不是文件: {log_path}")

        matched_lines = extract_error_lines(log_path)
    except FileNotFoundError as exc:
        print(f"错误: {exc}", file=sys.stderr)
        return 1
    except IsADirectoryError as exc:
        print(f"错误: {exc}", file=sys.stderr)
        return 1
    except PermissionError:
        print(f"错误: 没有权限读取文件: {log_path}", file=sys.stderr)
        return 1
    except OSError as exc:
        print(f"错误: 读取文件失败: {exc}", file=sys.stderr)
        return 1

    report = format_report(log_path, matched_lines)
    print(report)

    if not matched_lines:
        print("没有可分析的报错信息，已跳过大模型调用。")
        return 0

    try:
        analyze_errors_stream(report)
    except ValueError as exc:
        print(f"错误: {exc}", file=sys.stderr)
        return 1
    except AuthenticationError:
        print("错误: API 认证失败，请检查 API_KEY。", file=sys.stderr)
        return 1
    except RateLimitError:
        print("错误: 请求过于频繁或额度不足。", file=sys.stderr)
        return 1
    except APIConnectionError as exc:
        print(f"错误: 无法连接大模型服务: {exc}", file=sys.stderr)
        return 1
    except APIError as exc:
        print(f"错误: 大模型接口返回失败: {exc}", file=sys.stderr)
        return 1

    return 0


def launched_by_double_click() -> bool:
    """判断是否是在资源管理器里双击运行（窗口会在进程结束后立刻关掉）。"""
    if os.name != "nt":
        return False
    try:
        import ctypes

        process_ids = (ctypes.c_ulong * 4)()
        count = ctypes.windll.kernel32.GetConsoleProcessList(process_ids, 4)
        return count <= 1
    except Exception:
        return False


def pause_if_needed() -> None:
    if launched_by_double_click():
        input("\n运行结束，按回车键关闭窗口...")


if __name__ == "__main__":
    exit_code = 1
    try:
        exit_code = main()
    except SystemExit as exc:
        if isinstance(exc.code, int):
            exit_code = exc.code
        elif exc.code is None:
            exit_code = 0
        else:
            print(exc.code, file=sys.stderr)
            exit_code = 1
    finally:
        pause_if_needed()
    sys.exit(exit_code)
